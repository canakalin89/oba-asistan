{
  "manifest_version": 3,
  "name": "ÖBA Asistan",
  "version": "1.0.0",
  "description": "OBA eğitim videolarını arka planda otomatik izleyin. Öğretmenler için zaman kazandıran yardımcı.",
  "permissions": ["activeTab", "storage", "tabs"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://oba.gov.tr/*", "*://*.oba.gov.tr/*"],
      "js": [
        "utils/human-behavior.js",
        "content/video-handler.js",
        "content/scorm-handler.js",
        "content/content-handler.js",
        "content/navigation.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
